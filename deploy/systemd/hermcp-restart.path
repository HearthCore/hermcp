[Unit]
Description=Restart hermcp.service after a Hermes update (watches install-stamp.json)

[Path]
# Hermes writes this file with tempfile + os.replace (hermes_cli/source_stamp.py), which fires PathChanged.
PathChanged=/usr/local/lib/hermes-agent/install-stamp.json
Unit=hermcp-restart.service

[Install]
WantedBy=multi-user.target
